    "ISSUE_DAILY": ["SUMMARY_SUBMIT"],
    "ISSUE_MEDICAL": ["SUMMARY_SUBMIT"],
    "ISSUE_MEAL": ["SUMMARY_SUBMIT"],
    "ISSUE_CLEANING": ["SUMMARY_SUBMIT"],
    "ISSUE_ROOM": ["SUMMARY_SUBMIT"],
    "ISSUE_BEDDING": ["SUMMARY_SUBMIT"],
    "ISSUE_OTHER": ["SUMMARY_SUBMIT"]
