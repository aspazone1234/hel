  "screens": [
    {
      "id": "INTRO",
      "title": "Panchariya Seva Desk",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Panchariya Seva Desk" },
          {
            "type": "Image",
            "src": "https://res.cloudinary.com/ds0jyd7oj/image/upload/q_auto/f_auto/v1776504643/Your_paragraph_text_2_pl7x5l.png",
            "width": 320,
            "height": 120,
            "scale-type": "contain",
            "aspect-ratio": 3,
            "alt-text": "Panchariya Seva Desk intro banner"
          },
          {
            "type": "TextBody",
            "text": "Jay Shri Krishna,\nShrimad Bhagavad Katha 2026 mein aapka hardik swagat hai.\nYeh Panchariya Seva Desk aapki suvidha aur sahayata ke liye tayyar hai.\n\nAgar aapko paani, bhojan, safai, medical ya kisi bhi prakaar ki madad chahiye ho, toh yahan se aasani se apni request bhej sakte hain.\n\nHumari seva team aap tak jaldi se jaldi pahunchne ka poora prayas karegi."
          },
          {
            "type": "Footer",
            "label": "Aage Badhein",
            "on-click-action": {
              "name": "navigate",
              "next": { "type": "screen", "name": "CATEGORY_SELECTION" },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "CATEGORY_SELECTION",
      "title": "Category Chuniye",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Category Chuniye" },
          { "type": "TextBody", "text": "Aapko kis prakaar ki sahayata chahiye?" },
          {
            "type": "Dropdown",
            "name": "category",
            "label": "Category",
            "required": true,
            "data-source": [
              { "id": "paani_chai_coffee", "title": "Paani / Chai / Coffee" },
              { "id": "daily_use_items", "title": "Daily Use Items" },
              { "id": "medical_sahayata", "title": "Medical Sahayata" },
              { "id": "meal_request", "title": "Meal Request" },
              { "id": "safai_hygiene", "title": "Safai & Hygiene" },
              { "id": "room_utility_issue", "title": "Room / Utility Issue" },
              { "id": "bedding_comfort", "title": "Bedding / Comfort" },
              { "id": "lost_found_other_help", "title": "Lost & Found / Other Help" }
            ]
          },
          {
            "type": "Footer",
            "label": "Agla Step",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "category": "${form.category}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ISSUE_WATER",
      "title": "Issue Details",
      "data": {
        "category": { "type": "string", "__example__": "paani_chai_coffee" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Issue Details" },
          { "type": "TextBody", "text": "Apni request select kijiye." },
          {
            "type": "Dropdown",
            "name": "request_type",
            "label": "Request Type",
            "required": true,
            "data-source": [
              { "id": "drinking_water_request", "title": "Drinking Water Request" },
              { "id": "tea_request", "title": "Tea Request" },
              { "id": "coffee_request", "title": "Coffee Request" }
            ]
          },
          {
            "type": "TextArea",
            "name": "additional_details",
            "label": "Additional Details",
            "helper-text": "Agar kuch aur batana ho toh yahan likhiye",
            "required": false
          },
          {
            "type": "Footer",
            "label": "Summary Dekhein",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "category": "${data.category}",
                "request_type": "${form.request_type}",
                "additional_details": "${form.additional_details}"
              }
            }
          }
        ]
      }
    },
